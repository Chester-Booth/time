{
  "manifest_version": 2,
  "name": "Simple New Tab",
  "version": "1.0.0",
  "description": "A minimal clock new tab page with custom colours, text settings, and keyboard shortcuts.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-new-tab@chester-booth.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self';"
}
